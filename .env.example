# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI — Vercel AI Gateway (auto via OIDC on Vercel; set one locally)
# Option A: Vercel AI Gateway key (create at vercel.com/dashboard/ai)
VERCEL_AI_GATEWAY_API_KEY=vai_...
# Option B: Direct Anthropic key (local dev fallback)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (Phase 2)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (Phase 2)
RESEND_API_KEY=re_...

# App
NEXT_PUBLIC_APP_URL=https://habitdx.vercel.app
