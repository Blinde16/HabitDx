# HabitDx Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Local Development
# When running Supabase locally with `supabase start`, use:
# EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Environment
# Options: development, staging, production
NODE_ENV=development

# Notes:
# - EXPO_PUBLIC_ prefix makes these variables accessible in the Expo app
# - Never commit your actual .env file to git
# - For production builds, set these in your CI/CD environment or EAS secrets
