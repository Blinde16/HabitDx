{
  "name": "habitdx",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test:supabase": "ts-node scripts/test-supabase.ts",
    "test:auth": "ts-node scripts/test-auth.ts",
    "test:database": "ts-node scripts/test-database.ts",
    "test:all": "npm run test:auth && npm run test:database",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.0.0",
    "dotenv": "^17.3.0",
    "expo": "~50.0.0",
    "expo-auth-session": "^7.0.10",
    "expo-constants": "~15.4.6",
    "expo-crypto": "^15.0.8",
    "expo-device": "~5.9.4",
    "expo-haptics": "~12.8.1",
    "expo-notifications": "~0.27.8",
    "expo-router": "^3.0.0",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~1.11.1",
    "expo-web-browser": "^15.0.10",
    "nativewind": "^2.0.11",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.2",
    "react-native-web": "~0.19.6",
    "tailwindcss": "^3.3.2",
    "winston": "^3.19.0",
    "zustand": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "~18.2.45",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^8.0.0",
    "eslint-config-expo": "^7.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3"
  },
  "private": true
}
